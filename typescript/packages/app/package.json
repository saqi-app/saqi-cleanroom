{
  "name": "@saqi/app",
  "description": "Access-protected Saqi operations console",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "yarn@4.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern cloudflare-env.d.ts",
    "fix": "yarn fix::lint && yarn fix::format",
    "fix::lint": "eslint --fix . --ignore-pattern cloudflare-env.d.ts",
    "fix::format": "prettier --write src/",
    "check": "yarn check::lint && yarn check::format && yarn check::types",
    "check::lint": "eslint . --ignore-pattern cloudflare-env.d.ts",
    "check::format": "prettier --check src/",
    "check::types": "tsc --noEmit",
    "test": "vitest run",
    "opennext:build": "opennextjs-cloudflare build",
    "preview": "yarn opennext:build && opennextjs-cloudflare preview",
    "deploy": "rm -rf .open-next && yarn opennext:build && opennextjs-cloudflare deploy",
    "deploy:artifact": "opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply saqi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply saqi-db --remote",
    "db:list": "wrangler d1 migrations list saqi-db",
    "db:execute": "wrangler d1 execute saqi-db"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@radix-ui/react-slot": "^1.3.3",
    "@saqi/precedent-iso": "workspace:^",
    "@saqi/precedent-node": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "6.2.12",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.7",
    "better-sqlite3": "^13.0.3",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  }
}
