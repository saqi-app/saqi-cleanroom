{
  "name": "@saqi/precedent-node",
  "description": "Cloudflare-compatible persistence and task services for Saqi",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "packageManager": "yarn@4.16.0",
  "private": true,
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --build -w",
    "test": "vitest run",
    "fix": "yarn fix::lint && yarn fix::format",
    "fix::lint": "eslint --fix .",
    "fix::format": "prettier --write .",
    "check": "yarn check::lint && yarn check::format && yarn check::types",
    "check::lint": "eslint .",
    "check::format": "prettier --check .",
    "check::types": "tsc --noEmit",
    "clean": "yarn clean::dist",
    "clean::dist": "rm -rf tsconfig.tsbuildinfo dist"
  },
  "dependencies": {
    "@saqi/precedent-iso": "workspace:^",
    "@saqi/source-adapter": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "uuidv7": "^1.2.1",
    "zod": "4.5.4"
  }
}
