---
import type { TranslationModelProvider } from "../lib/poem-translations";

interface Props {
  provider: TranslationModelProvider;
}

const { provider } = Astro.props;
---

<svg
  class:list={["translation-model-mark", `translation-model-mark--${provider}`]}
  focusable="false"
  viewBox="0 0 24 24"
  width="24"
  height="24"
>
  {provider === "anthropic" ? (
    <path d="M12 2.8v18.4M5.5 6.5l13 11M2.8 12h18.4M5.5 17.5l13-11" />
  ) : provider === "google" ? (
    <path d="M12 2.5c.55 5.8 3.7 8.95 9.5 9.5-5.8.55-8.95 3.7-9.5 9.5-.55-5.8-3.7-8.95-9.5-9.5 5.8-.55 8.95-3.7 9.5-9.5Z" />
  ) : provider === "openai" ? (
    <>
      <path d="M12 3.1a4.45 4.45 0 0 1 4.35 3.5 4.45 4.45 0 0 1 2.85 6.1 4.45 4.45 0 0 1-3.65 5.55 4.45 4.45 0 0 1-6.9-.85 4.45 4.45 0 0 1-2.85-6.1A4.45 4.45 0 0 1 9.45 5.75 4.4 4.4 0 0 1 12 3.1Z" />
      <path d="m8.7 6.2 6.6 3.8v7.6M5.8 11.3l6.6 3.8 6.6-3.8M8.65 17.4V9.8l6.6-3.8" />
    </>
  ) : (
    <>
      <rect x="5" y="5" width="14" height="14" rx="3" />
      <path d="M9 9h6v6H9zM9 2v3m6-3v3M9 19v3m6-3v3M2 9h3m-3 6h3m14-6h3m-3 6h3" />
    </>
  )}
</svg>
