{
  "name": "@saqi/source-adapter",
  "description": "Pure, runtime-neutral source policies and projection parsers",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "packageManager": "yarn@4.16.0",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build --force",
    "check": "yarn check::lint && yarn check::format && yarn check::types",
    "check::lint": "eslint .",
    "check::format": "prettier --check .",
    "check::types": "tsc --noEmit",
    "clean": "rm -rf tsconfig.tsbuildinfo dist",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@saqi/precedent-iso": "workspace:^",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
